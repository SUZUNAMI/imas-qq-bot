# 复制为 .env 并填入真实值（.env 不进 git；服务器上另行配置）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 以下均为可选覆盖（缺省见 config.yaml / 内置默认）：
# DEEPSEEK_BASE_URL=https://api.deepseek.com        # 或 https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_TEMPERATURE=0.3

# M6 QQ 推送（NapCat / OneBot 11）可选覆盖（优先级高于 config.yaml 的 napcat 段）：
# NAPCAT_BASE_URL=http://127.0.0.1:3000
# NAPCAT_TOKEN=
# NAPCAT_GROUP_IDS=123456789,987654321
# NAPCAT_INTERVAL_SEC=1.5
